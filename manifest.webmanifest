      "icons": [{ "src": "assets/icons/icon-96.png", "sizes": "96x96" }] },
    { "name": "Check in", "short_name": "Check in", "url": "./index.html#/checkin",
      "icons": [{ "src": "assets/icons/icon-96.png", "sizes": "96x96" }] },
    { "name": "Your order", "short_name": "Order",  "url": "./index.html#/bag",
